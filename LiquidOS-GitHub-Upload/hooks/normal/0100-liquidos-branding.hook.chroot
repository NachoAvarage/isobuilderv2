#!/bin/bash
set -Eeuo pipefail

install -d -m 0755 /etc/skel/.config /etc/skel/.local/share /etc/skel/.config/autostart
install -d -m 0755 /usr/share/liquidos /usr/share/wallpapers/LiquidOS/contents/images
cp /tmp/liquidos-wallpaper.png /usr/share/wallpapers/LiquidOS/contents/images/1920x1080.png

CURSOR_THEME="Breeze"
if [[ -d /usr/share/icons/capitaine-cursors ]]; then
  CURSOR_THEME="capitaine-cursors"
fi

cat > /etc/skel/.config/kdeglobals <<CFG
[General]
ColorScheme=BreezeDark
Name=LiquidOS
widgetStyle=Breeze

[KDE]
LookAndFeelPackage=org.kde.breezedark.desktop

[Icons]
Theme=breeze

[Cursor]
Theme=${CURSOR_THEME}
Size=24

[WM]
activeBackground=28,32,42
activeForeground=245,247,250
inactiveBackground=23,26,34
inactiveForeground=185,191,202
CFG

cat > /etc/skel/.config/kwinrc <<'CFG'
[Compositing]
Backend=OpenGL
Enabled=true
GLCore=true
GLPreferBufferSwap=a
LatencyPolicy=PreferSmoothness
MaxFPS=60
ScaleMethod=Accurate

[Effect-blur]
BlurStrength=6
NoiseStrength=1

[Plugins]
blurEnabled=true
contrastEnabled=true
kwin4_effect_fadeEnabled=true
kwin4_effect_maximizeEnabled=true
kwin4_effect_translucencyEnabled=true

[Windows]
BorderlessMaximizedWindows=true
CFG

cat > /etc/skel/.config/plasmarc <<'CFG'
[Theme]
name=breeze-dark
CFG

cat > /etc/skel/.config/kscreenlockerrc <<'CFG'
[Daemon]
Autolock=false
LockOnResume=false
CFG

for gtkver in 3.0 4.0; do
  install -d -m 0755 "/etc/skel/.config/gtk-${gtkver}"
  cat > "/etc/skel/.config/gtk-${gtkver}/settings.ini" <<CFG
[Settings]
gtk-theme-name=Breeze
gtk-icon-theme-name=breeze
gtk-cursor-theme-name=${CURSOR_THEME}
gtk-cursor-theme-size=24
gtk-application-prefer-dark-theme=1
CFG
done

# Apply the bundled wallpaper once the Plasma session has started.
cat > /usr/local/bin/liquidos-first-login <<'SCRIPT'
#!/bin/bash
set -e
WALL='/usr/share/wallpapers/LiquidOS/contents/images/1920x1080.png'
for _ in $(seq 1 30); do
  if pgrep -x plasmashell >/dev/null 2>&1; then
    if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
      plasma-apply-wallpaperimage "$WALL" >/dev/null 2>&1 || true
    fi
    break
  fi
  sleep 2
done
rm -f "$HOME/.config/autostart/liquidos-first-login.desktop"
SCRIPT
chmod 0755 /usr/local/bin/liquidos-first-login

cat > /etc/skel/.config/autostart/liquidos-first-login.desktop <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=LiquidOS desktop setup
Exec=/usr/local/bin/liquidos-first-login
X-KDE-autostart-phase=2
NoDisplay=true
DESKTOP

cat > /usr/share/liquidos/README.txt <<'TXT'
LiquidOS
A clean, macOS-inspired Linux desktop.

Visual profile:
- Minimal dark graphite wallpaper
- KDE Plasma desktop with subtle KWin blur and compositing
- Breeze Dark palette and simple Breeze icons
- Capitaine pointer theme when available, otherwise Breeze
- Native Linux apps, networking and VirtualBox guest integration

LiquidOS is an independent Linux distribution concept and is not affiliated with Apple.
TXT

install -d -m 0755 /etc/sddm.conf.d
cat > /etc/sddm.conf.d/liquidos.conf <<'CFG'
[Theme]
Current=breeze

[General]
DisplayServer=wayland
CFG

install -d -m 0755 /etc/skel/Desktop
cat > /etc/skel/Desktop/Welcome-to-LiquidOS.desktop <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Welcome to LiquidOS
Comment=Read about this desktop
Exec=xdg-open file:///usr/share/liquidos/README.txt
Icon=help-about
Terminal=false
Categories=Utility;
DESKTOP
chmod 0644 /etc/skel/Desktop/Welcome-to-LiquidOS.desktop
